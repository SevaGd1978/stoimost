# Скопируйте в .env и подставьте значения (или экспортируйте переменные окружения).

# Порт веб-интерфейса
PORT=3100

# demo — без выхода в сеть (примеры карточек); live — реальные запросы к ЕИС
TENDER_SPY_MODE=live

# Автоопрос ЕИС, минут (можно менять и в интерфейсе)
TENDER_SPY_POLL_MIN=30

# Пауза между запросами к ЕИС, мс — не ставьте меньше 1000, ЕИС банит по частоте
TENDER_SPY_REQUEST_DELAY_MS=1500

# Путь к файлу базы (JSON)
# TENDER_SPY_DATA=./data/db.json

# Telegram-уведомления о новых закупках (бот → @BotFather; chat_id → @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Прокси (HTTP / HTTPS / SOCKS5) для запросов к ЕИС из-за пределов РФ
# HTTPS_PROXY=http://user:password@proxy-host:port
# HTTP_PROXY=http://proxy-host:port

